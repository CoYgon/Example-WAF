# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Reverse proxy
# false = direct connection
# true  = trust one reverse proxy
TRUST_PROXY=false

# Rate limiting
WINDOW_MS=60000
MAX_REQUESTS_PER_WINDOW=60

# Threat thresholds
SOFT_THRESHOLD=30
HARD_THRESHOLD=60
CRITICAL_THRESHOLD=100

# Ban durations
SOFT_BAN_MS=900000
HARD_BAN_MS=7200000
CRITICAL_BAN_MS=86400000

# Request limits
MAX_BODY_SIZE=1048576
MAX_VIOLATIONS_HISTORY=100

# Optional IP lists
WHITELIST_IPS=
BLACKLIST_CIDRS=

# Admin API
# IMPORTANT:
# Set a strong random value before exposing the service publicly.
ADMIN_TOKEN=change-this-in-production

# Event storage
MAX_EVENTS=1000